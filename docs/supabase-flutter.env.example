# Copia estos valores al correr la app (no commits con claves reales).
#
# flutter run \
#   --dart-define=SUPABASE_URL=https://TU_API \
#   --dart-define=SUPABASE_ANON_KEY=eyJ... \
#   --dart-define=GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com
#
# O rellena fallbacks en:
# lib/nucleo/supabase/config_supabase.dart

SUPABASE_URL=https://tu-api-supabase.example.com
SUPABASE_ANON_KEY=tu_anon_key_aqui

# Mismo Client ID tipo Web que en el Auth del VPS (GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID).
# El Client ID Android (SHA-1 + package) NO va aquí; solo en Google Cloud.
GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com

# Opcional (iOS):
# GOOGLE_IOS_CLIENT_ID=yyy.apps.googleusercontent.com
